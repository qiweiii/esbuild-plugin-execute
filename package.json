{
  "name": "esbuild-plugin-execute",
  "version": "1.0.0",
  "description": "A tool to create esbuild plugins with a bunch of binaries 🙂",
  "keywords": [
    "esbuild",
    "esbuild-plugin",
    "go",
    "node",
    "binary",
    "execute"
  ],
  "homepage": "https://github.com/qiweiii/esbuild-plugin-execute#readme",
  "bugs": {
    "url": "https://github.com/qiweiii/esbuild-plugin-execute/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiweiii/esbuild-plugin-execute.git"
  },
  "license": "MIT",
  "author": "qiwei",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    "import": {
      "types": "./build/index.d.mts",
      "default": "./build/esm.mjs"
    },
    "require": {
      "types": "./build/index.d.cts",
      "default": "./build/cjs.js"
    }
  },
  "main": "build/cjs.js",
  "module": "build/esm.mjs",
  "types": "build/index.d.ts",
  "files": [
    "build/*",
    "package.json"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir build && node ./scripts/copy-types.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src scripts test",
    "test": "pnpm run build && pnpm run build:types && node --test test/*.test.mjs",
    "test:go": "pnpm run build && node --test test/go.test.mjs",
    "hooks:setup": "husky",
    "types": "tsc --noEmit",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "svelte": "5.57.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "esbuild": "^0.28.2"
  }
}
